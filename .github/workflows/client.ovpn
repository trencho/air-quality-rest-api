# OpenVPN client profile for the deploy workflow.
#
# DO NOT DELETE. It looks unreferenced — nothing in this repository names it — because the
# reference lives in the OPENVPN_CONFIG secret, which holds this file's PATH. Deleting it
# breaks every deploy at the VPN step with a masked "config file '***' not found".
#
# DO NOT ADD KEY MATERIAL. This file must carry only the paths below; ca.crt, client.crt
# and tls-crypt.key are written at runtime from secrets, and the client key comes from
# USER_KEY via the action's client_key: input. An earlier revision of this file did embed
# an inline tls-crypt key and had to be purged from the public history.

client
dev tun
proto udp
remote 194.149.144.244 11194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA512
cipher AES-256-GCM
ignore-unknown-option block-outside-dns
block-outside-dns
verb 3
ca /etc/openvpn/ca.crt
cert /etc/openvpn/client.crt
tls-crypt /etc/openvpn/tls-crypt.key
